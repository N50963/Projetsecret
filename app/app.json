{
  "expo": {
    "name": "MenuBily",
    "slug": "menus-du-foyer",
    "scheme": "menusdufoyer",
    "version": "0.17.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "fr.foyer.menus",
      "versionCode": 17,
      "adaptiveIcon": {
        "backgroundColor": "#FEF3E3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisir une photo pour illustrer une recette.",
          "cameraPermission": "Prendre en photo un plat pour illustrer sa recette."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
